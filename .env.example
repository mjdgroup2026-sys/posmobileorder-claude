# ─────────────────────────────────────────────────────────────────────────────
# ตัวอย่างค่า environment ของ MJD Mobile Order — คัดลอกไปใช้จริง 2 แบบ
#
#   รันบนเครื่อง (pnpm dev)          : cp .env.example .env
#   รันด้วย docker compose           : cp .env.example .env.docker
#                                      docker compose --env-file .env.docker up -d
#
# ⚠️ ไฟล์นี้เป็นตัวอย่างเท่านั้น ห้ามใส่ค่าจริง/ความลับลงไปแล้ว commit
# ─────────────────────────────────────────────────────────────────────────────

# ───────────────── ฐานข้อมูล (docker compose ใช้ 3 ตัวนี้สร้าง DATABASE_URL ให้เอง) ────────────────
POSTGRES_USER=posmobileorderuser
POSTGRES_DB=posmobileorderdb
# ⚠️ ห้ามมีอักขระ / : @ # ? — connection string ถูกประกอบเป็น URL ตรง ๆ
# ถ้ามี @prisma/adapter-pg จะฟ้อง "Invalid URL" แล้วแอปต่อฐานไม่ได้ทั้งระบบ
# สร้างด้วย: openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
POSTGRES_PASSWORD=change-me-base64url

# port ฝั่ง host (ในคอนเทนเนอร์ยังเป็น 5432 เสมอ)
# 5437 ถูก container posmobileorder-postgres ของ dev ยึดอยู่
DB_PORT=5438

# ── เฉพาะตอนรันบนเครื่องแบบไม่ใช้ compose ──
# compose ไม่ต้องตั้งค่านี้ (docker-compose.yml ประกอบ DATABASE_URL ให้แล้ว โดยชี้ host เป็น "db")
DATABASE_URL=postgresql://posmobileorderuser:change-me-base64url@localhost:5437/posmobileorderdb?schema=public

# ───────────────────────────────── แอป ────────────────────────────────
# port ฝั่ง host ของ service app (3000 = pos-app เดิม, 3001 = dev server)
APP_PORT=3002

# ต้องตรงกับ origin ที่เปิดใช้จริงเป๊ะ ๆ ไม่งั้น Better Auth ตอบ INVALID_ORIGIN ตอน sign-in
#   pnpm dev        → http://localhost:3001
#   docker compose  → http://localhost:3002
#   production      → https://posqr.jayjayservices.com
BETTER_AUTH_URL=http://localhost:3002

# ใช้เซ็น/เข้ารหัส session cookie — production ต้องเป็นคนละค่ากับ dev
# สร้างด้วย: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-random-32-bytes

# ──────────────────────────── อีเมล (Phase 5) ───────────────────────────
# เว้นว่างได้: dev จะพิมพ์ลิงก์ลง console ส่วน production จะ throw เมื่อมีการส่งอีเมล
RESEND_API_KEY=
# ต้องอยู่ใต้โดเมนที่ verify กับ Resend ไว้แล้ว
MAIL_FROM=MJD Mobile Order <no-reply@mail.jayjayservices.com>
MAIL_REPLY_TO=
